{
  "name": "safelabs-guard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "benchmark": "tsx scripts/run-benchmark.ts",
    "bench:replay": "SAFELABS_BENCH_MODE=replay tsx scripts/bench.ts",
    "bench:record": "SAFELABS_BENCH_MODE=record tsx scripts/bench.ts",
    "bench:live-plan": "tsx scripts/bench.ts --plan",
    "bench:images": "tsx scripts/bench-make-images.ts",
    "bench:audio": "bash scripts/bench-make-audio.sh",
    "bench:scan": "tsx scripts/bench-scan-recordings.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
