# Copy to .env.local for local development. Never commit real values.

# --- Meta API keys (server-side only; leave blank to use mocks) ---
META_SPARK_API_KEY=
META_SAM_API_KEY=
META_VOICE_API_KEY=

# --- Live vs mock ---
# Live calls happen only when this is exactly "false" AND the client's key is set.
# Any other value (including unset) uses mock clients.
# /api/agent/turn: "true" = explicit mock mode (mock perception ALLOWs any valid frame;
# local demos only). Unset = mock clients but guarded turns fail closed (BLOCK).
SAFELABS_USE_MOCKS=true
# Production (NODE_ENV=production or VERCEL_ENV=production, which includes `next start`
# and Vercel previews) refuses /api/agent/turn and /api/packproof/ship with 503 unless
# SAFELABS_USE_MOCKS=false. Set this to exactly "true" only for a deliberate, labelled
# mock-only deploy.
SAFELABS_ALLOW_MOCK_IN_PRODUCTION=

# --- Image text (what reads signs/labels in the frame for injection checks) ---
# mock (default) | spark (Muse Spark image input; run the probe first:
#   npx tsx scripts/agent-demo.ts --probe-spark-image) | ocr (needs tesseract.js installed)
# In live mode, "mock" cannot read real frames, so every guarded turn BLOCKs.
SAFELABS_VISION=mock
# "true" also sends the frame to Spark reasoning as an image part (unverified).
SAFELABS_SPARK_IMAGES=

# --- Signed session and SHIP approval tokens ---
# HMAC-SHA256 key, at least 32 characters. Required in production (routes return 503
# without it). Outside production a random per-process key is used if blank.
# Generate one with:  openssl rand -base64 48
SAFELABS_TOKEN_SECRET=

# --- Abuse limits (in-memory, per server instance; best effort) ---
# Apply to /api/agent/turn, /api/guard/live-check and the status probe;
# /api/packproof/ship has its own bucket.
# Requests per IP per sliding minute (default 8; ship route default 20).
# Setting this overrides both defaults.
# SAFELABS_RATE_LIMIT_PER_MIN=8
# Live Meta calls per UTC day across all callers (default 300).
SAFELABS_DAILY_CAP=300

# --- Kill switch ---
# "true" forces mock clients everywhere and labels every source "mock".
# In production this makes the agent routes return 503 (unless mock is allowed above).
SAFELABS_LIVE_DISABLED=

# --- Admin ---
# GET /api/meta/status?probe=1 makes live Meta calls only when the request sends header
# x-safelabs-admin with exactly this value. Blank = probing is off (status is config-only).
# Generate one with:  openssl rand -base64 32
SAFELABS_ADMIN_TOKEN=
